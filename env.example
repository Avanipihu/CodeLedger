# ============================================================
# CodeLedger environment variables
# Copy this file to ".env" (same folder as app.py) and fill it in.
# On Render/Railway etc: add each line in the "Environment" tab instead.
# NEVER commit .env to GitHub (it is already in .gitignore).
# ============================================================

# ---------- MySQL (Aiven) : choose OPTION A *or* OPTION B ----------

# OPTION A (simplest): one single line. Copy "Service URI" from the Aiven console.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl-mode=REQUIRED
MYSQL_URI=mysql://avnadmin:YOUR_PASSWORD@mysql-49d7928-jainavanipihu-8b11.l.aivencloud.com:YOUR_PORT/defaultdb?ssl-mode=REQUIRED

# OPTION B: separate values (delete MYSQL_URI above if you use these)
# MYSQL_HOST=mysql-49d7928-jainavanipihu-8b11.l.aivencloud.com
# MYSQL_PORT=YOUR_PORT
# MYSQL_USER=avnadmin
# MYSQL_PASSWORD=YOUR_PASSWORD
# MYSQL_DB=defaultdb

# ---------- MySQL SSL / TLS ----------
# Aiven hosts (aivencloud.com) turn SSL on automatically, so you can leave these alone.
# For verified SSL, download ca.pem from Aiven and use ONE of the next two:
# MYSQL_SSL_CA=./ca.pem
# MYSQL_SSL_CA_PEM=-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----
# Testing only (encrypts but does not verify). Don't use in production:
# MYSQL_SSL_INSECURE=false
# MYSQL_SSL=true

# Seconds to wait for the DB before giving up (default 15)
MYSQL_CONNECT_TIMEOUT=15

# ---------- MongoDB (used to enrich results; optional) ----------
# Local MongoDB is the default. If you deployed online, use a MongoDB Atlas URI.
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=codeledger

# ---------- Flask ----------
SECRET_KEY=change-this-to-a-long-random-string
